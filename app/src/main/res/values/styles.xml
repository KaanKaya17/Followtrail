<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_light_violet</item>
        <item name="android:colorControlHighlight">#18674BD8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/theme_light_background</item>
        <item name="android:navigationBarColor">@color/theme_light_ink</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/theme_light_background</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:alertDialogTheme">@style/TrackerDialogTheme</item>
    </style>
    <style name="TrackerDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_light_violet</item>
        <item name="android:colorControlHighlight">#18674BD8</item>
        <item name="android:colorBackground">@color/theme_light_surface</item>
        <item name="android:colorBackgroundFloating">@color/theme_light_surface</item>
        <item name="android:textColorPrimary">@color/theme_light_ink</item>
        <item name="android:textColorSecondary">@color/theme_light_muted</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:buttonBarButtonStyle">@style/TrackerDialogButton</item>
    </style>
    <style name="TrackerDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/theme_light_violet</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_dark_violet</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/theme_dark_background</item>
        <item name="android:navigationBarColor">@color/theme_dark_background</item>
        <item name="android:windowBackground">@color/theme_dark_background</item>
        <item name="android:colorBackground">@color/theme_dark_background</item>
        <item name="android:textColorPrimary">@color/theme_dark_ink</item>
        <item name="android:textColorSecondary">@color/theme_dark_muted</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:alertDialogTheme">@style/TrackerDialogDark</item>
    </style>
    <style name="TrackerDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_dark_violet</item>
        <item name="android:colorBackground">@color/theme_dark_surface</item>
        <item name="android:colorBackgroundFloating">@color/theme_dark_surface</item>
        <item name="android:textColorPrimary">@color/theme_dark_ink</item>
        <item name="android:textColorSecondary">@color/theme_dark_muted</item>
        <item name="android:windowBackground">@drawable/dialog_surface_dark</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:buttonBarButtonStyle">@style/TrackerDialogButtonDark</item>
    </style>
    <style name="TrackerDialogButtonDark" parent="TrackerDialogButton">
        <item name="android:textColor">@color/theme_dark_violet</item>
    </style>
    <style name="AppThemeOled" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_oled_violet</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/theme_oled_background</item>
        <item name="android:navigationBarColor">@color/theme_oled_background</item>
        <item name="android:windowBackground">@color/theme_oled_background</item>
        <item name="android:colorBackground">@color/theme_oled_background</item>
        <item name="android:textColorPrimary">@color/theme_oled_ink</item>
        <item name="android:textColorSecondary">@color/theme_oled_muted</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:alertDialogTheme">@style/TrackerDialogOled</item>
    </style>
    <style name="TrackerDialogOled" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/theme_oled_violet</item>
        <item name="android:colorBackground">@color/theme_oled_surface</item>
        <item name="android:colorBackgroundFloating">@color/theme_oled_surface</item>
        <item name="android:textColorPrimary">@color/theme_oled_ink</item>
        <item name="android:textColorSecondary">@color/theme_oled_muted</item>
        <item name="android:windowBackground">@drawable/dialog_surface_oled</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:buttonBarButtonStyle">@style/TrackerDialogButtonOled</item>
    </style>
    <style name="TrackerDialogButtonOled" parent="TrackerDialogButton">
        <item name="android:textColor">@color/theme_oled_violet</item>
    </style>
</resources>
